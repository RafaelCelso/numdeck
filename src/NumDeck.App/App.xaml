<Application x:Class="NumDeck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Professional slate-blue accent for Fluent controls (check boxes, focus lines,
                 selected items, accent buttons). Defined outside merged dictionaries so they
                 take precedence over the system Fluent theme values. -->
            <Color x:Key="{x:Static SystemColors.AccentColorKey}">#2563EB</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorLight1Key}">#3B82F6</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorLight2Key}">#60A5FA</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorLight3Key}">#93C5FD</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorDark1Key}">#1D4ED8</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorDark2Key}">#1E40AF</Color>
            <Color x:Key="{x:Static SystemColors.AccentColorDark3Key}">#1E3A8A</Color>
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorBrushKey}" Color="#2563EB" />
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorLight1BrushKey}" Color="#3B82F6" />
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorLight2BrushKey}" Color="#60A5FA" />
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorLight3BrushKey}" Color="#93C5FD" />
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorDark1BrushKey}" Color="#1D4ED8" />
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorDark2BrushKey}" Color="#1E40AF" />
            <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorDark3BrushKey}" Color="#1E3A8A" />
            <SolidColorBrush x:Key="AccentFillColorPrimaryBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="AccentDefaultBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="AccentTertiaryBrush" Color="#1D4ED8" />
            <Color x:Key="SystemAccentColor">#2563EB</Color>
            <Color x:Key="SystemAccentColorLight1">#3B82F6</Color>
            <Color x:Key="SystemAccentColorLight2">#60A5FA</Color>
            <Color x:Key="SystemAccentColorLight3">#93C5FD</Color>
            <Color x:Key="SystemAccentColorDark1">#1D4ED8</Color>
            <Color x:Key="SystemAccentColorDark2">#1E40AF</Color>
            <Color x:Key="SystemAccentColorDark3">#1E3A8A</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#1D4ED8" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#60A5FA" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#93C5FD" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#3B82F6" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
