<Window x:Class="NumDeck.App.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escolher aplicativos" Icon="Assets/numdeck.ico"
        Width="520" Height="640" MinWidth="380" MinHeight="400" Background="{StaticResource NdBg}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Marque um ou mais aplicativos. Todos abrem juntos quando você apertar a tecla." />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />
            <TextBlock Text="Pesquisar aplicativo…" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <ListBox x:Name="AppList" Grid.Row="2" SelectionMode="Single"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 KeyDown="AppList_KeyDown" PreviewMouseLeftButtonUp="AppList_PreviewMouseLeftButtonUp">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Background="Transparent">
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Center"
                                  MinWidth="0" Margin="0,0,6,0" Focusable="False" />
                        <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="LoadingText" Grid.Row="2" Text="Carregando aplicativos…" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="Adicionar" MinWidth="96" IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}" Click="Ok_Click" />
                <Button Content="Cancelar" MinWidth="96" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </DockPanel>
    </Grid>
</Window>
