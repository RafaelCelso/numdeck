<Window x:Class="NumDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NumDeck.App.ViewModels"
        xmlns:actions="clr-namespace:NumDeck.Core.Actions;assembly=NumDeck.Core"
        Title="NumDeck" Icon="Assets/numdeck.ico"
        Width="1320" Height="820" MinWidth="1120" MinHeight="680" Background="#080B12"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- ===== Action editors (one per action type) ===== -->

        <DataTemplate DataType="{x:Type actions:LaunchAppAction}">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Aplicativos a abrir" />
                <ListBox x:Name="AppList" ItemsSource="{Binding Apps}" MaxHeight="230"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding Apps.Count, Converter={x:Static vm:Converters.NonZeroToVisible}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Background="Transparent">
                                <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" Margin="6,0,0,0" Click="RemoveApp_Click"
                                        ToolTip="Remover da tecla" AutomationProperties.Name="Remover" />
                                <Image DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,10,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding Path, Converter={x:Static vm:Converters.ShellIcon}}" />
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Path}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Style="{StaticResource Hint}" Text="Nenhum aplicativo escolhido ainda."
                           Visibility="{Binding Apps.Count, Converter={x:Static vm:Converters.ZeroToVisible}}" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Escolher aplicativos…" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,6,6"
                            Click="PickApps_Click" ToolTip="Lista dos aplicativos do menu Iniciar. Marque quantos quiser." />
                    <Button Content="Outro arquivo…" Margin="0,0,0,6" Click="BrowseApp_Click"
                            ToolTip="Um programa, atalho, script ou documento que não aparece na lista." />
                </WrapPanel>

                <StackPanel Visibility="{Binding SelectedItem, ElementName=AppList, Converter={x:Static vm:Converters.NotNullToVisible}}">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <Run Text="Opções de " /><Run Text="{Binding SelectedItem.DisplayName, ElementName=AppList, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,4" Text="Argumentos (opcional)" />
                    <TextBox Text="{Binding SelectedItem.Arguments, ElementName=AppList, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta de trabalho (opcional)" />
                    <TextBox Text="{Binding SelectedItem.WorkingDirectory, ElementName=AppList, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="Clique num aplicativo da lista para definir argumentos."
                           Visibility="{Binding SelectedItem, ElementName=AppList, Converter={x:Static vm:Converters.NullToVisible}}" />

                <CheckBox Margin="0,12,0,0" IsChecked="{Binding BringToFrontIfRunning}"
                          Content="Se já estiver aberto, só trazer para a frente" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type actions:OpenBrowserAction}">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Navegador" />
                <ComboBox ItemsSource="{Binding DataContext.BrowserOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding BrowserId}"
                          SelectionChanged="Browser_SelectionChanged" />
                <DockPanel Margin="0,6,0,0">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BrowserId}" Value="custom">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <Button DockPanel.Dock="Right" Content="Procurar…" Margin="6,0,0,0" Click="BrowseBrowser_Click" />
                    <TextBox Text="{Binding CustomPath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <TextBlock Style="{StaticResource FieldLabel}" Text="Abas a abrir (uma URL por linha)" />
                <TextBox Text="{Binding UrlsText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True"
                         TextWrapping="NoWrap" Height="130" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
                <TextBlock Style="{StaticResource Hint}" Text="Ex.: mail.google.com — o https:// é adicionado automaticamente." />

                <CheckBox Margin="0,12,0,0" IsChecked="{Binding NewWindow}" Content="Abrir numa nova janela" />
                <CheckBox Margin="0,8,0,0" IsChecked="{Binding Incognito}" Content="Abrir em janela anônima (privada)"
                          ToolTip="Chrome/Comet/Brave: anônima · Edge: InPrivate · Firefox/Opera: navegação privada" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Perfil do navegador (opcional)" />
                <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Chrome/Edge/Comet/Brave: nome da pasta do perfil (ex.: Default, Profile 1). Firefox: nome do perfil." />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type actions:OpenFolderAction}">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Abrir em" />
                <ComboBox ItemsSource="{Binding DataContext.FolderLocations, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Location}" />
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Location}" Value="Custom">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Escolher pasta…" Margin="6,0,0,0" Click="BrowseFolder_Click" />
                        <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Também aceita pastas de rede (\\servidor\pasta) e variáveis como %USERPROFILE%\Projetos." />
                </StackPanel>
                <CheckBox Margin="0,12,0,0" IsChecked="{Binding ReuseOpenWindow}"
                          Content="Se a pasta já estiver aberta, só trazer a janela para a frente" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type actions:PlaySoundAction}">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Arquivo de som (MP3, WAV, …)" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Procurar…" Margin="6,0,0,0" Click="BrowseSound_Click" />
                    <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Style="{StaticResource FieldLabel}">
                    <Run Text="Volume: " /><Run Text="{Binding Volume, StringFormat={}{0:P0}, Mode=OneWay}" />
                </TextBlock>
                <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" SmallChange="0.05" LargeChange="0.1" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Saída de áudio" />
                <ComboBox ItemsSource="{Binding DataContext.AudioOutputs, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding OutputDeviceId}" />
                <CheckBox Margin="0,12,0,0" IsChecked="{Binding StopIfPlaying}"
                          Content="Apertar de novo enquanto toca para parar" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type actions:MacroAction}">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Gravar atalho: clique aqui e pressione a combinação" />
                <TextBox x:Name="RecordBox" IsReadOnly="True" PreviewKeyDown="RecordShortcut_PreviewKeyDown"
                         Text="(clique e pressione, ex.: Ctrl+Shift+M)" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Passos (um por linha)" />
                <TextBox Text="{Binding Script, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="150"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="NoWrap" />
                <TextBlock Style="{StaticResource Hint}" Foreground="#D13438" Text="{Binding Validation}"
                           Visibility="{Binding Validation, Converter={x:Static vm:Converters.NonEmptyToVisible}}" />
                <TextBlock Style="{StaticResource Hint}" FontFamily="Consolas" xml:space="preserve">Exemplos:
  Ctrl+Shift+M          → atalho
  Win+D                 → mostrar área de trabalho
  texto: Olá, tudo bem? → digita o texto
  espera: 300           → aguarda 300 ms
Teclas: Enter, Tab, Esc, Space, Delete, Home, End, PageUp, Up/Down/Left/Right, F1–F24, A–Z, 0–9.</TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type actions:MediaAction}">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Comando" />
                <ComboBox ItemsSource="{Binding DataContext.MediaOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Command}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Funciona com Spotify, YouTube no navegador, players do Windows etc. O mudo do microfone age no microfone padrão de comunicação." />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type actions:SwitchProfileAction}">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Ao apertar" />
                <ComboBox ItemsSource="{Binding DataContext.ProfileSwitchModes, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Mode}" Value="Specific">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Perfil" />
                    <ComboBox ItemsSource="{Binding DataContext.Config.Profiles, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ProfileId}"
                              SelectionChanged="Profile_SelectionChanged" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Dica: coloque a troca de perfil em “Teclas globais” para ela funcionar em todos os perfis." />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ===== Background: dark base, neon glows, faint grid ===== -->
        <Rectangle Fill="{StaticResource NdBg}" />
        <Ellipse Width="900" Height="700" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-380,-420,0,0" Opacity="0.22" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#8B5CF6" Offset="0" />
                    <GradientStop Color="#008B5CF6" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="1000" Height="800" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-460,-480" Opacity="0.16" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#22D3EE" Offset="0" />
                    <GradientStop Color="#0022D3EE" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Rectangle Fill="{StaticResource NdGridPattern}" IsHitTestVisible="False" />

        <Grid Margin="20,14,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Bloquear teclas do deck" IsChecked="{Binding Config.BlockDeckKeys}" VerticalAlignment="Center"
                              ToolTip="Impede que a tecla apertada no deck também seja digitada no programa em foco." />
                    <ToggleButton Margin="16,0,0,0" Padding="14,6" IsChecked="{Binding IsPaused}"
                                  ToolTip="Pausa as ações do deck (as teclas voltam a digitar normalmente).">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Pausar" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <!-- Logo: a tiny keypad on a gradient tile -->
                    <Grid Width="42" Height="42" VerticalAlignment="Center">
                        <Border CornerRadius="11" Background="{StaticResource NdBrand}" Opacity="0.55">
                            <Border.Effect>
                                <BlurEffect Radius="14" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="11" Background="{StaticResource NdBrand}">
                            <UniformGrid Rows="3" Columns="3" Margin="9">
                                <Border CornerRadius="2" Margin="1.5" Background="#E6FFFFFF" />
                                <Border CornerRadius="2" Margin="1.5" Background="#E6FFFFFF" />
                                <Border CornerRadius="2" Margin="1.5" Background="#E6FFFFFF" />
                                <Border CornerRadius="2" Margin="1.5" Background="#E6FFFFFF" />
                                <Border CornerRadius="2" Margin="1.5" Background="#06121A" />
                                <Border CornerRadius="2" Margin="1.5" Background="#E6FFFFFF" />
                                <Border CornerRadius="2" Margin="1.5" Background="#E6FFFFFF" />
                                <Border CornerRadius="2" Margin="1.5" Background="#E6FFFFFF" />
                                <Border CornerRadius="2" Margin="1.5" Background="#E6FFFFFF" />
                            </UniformGrid>
                        </Border>
                    </Grid>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource NdDisplay}" FontSize="22" FontWeight="SemiBold">
                            <Run Text="Num" Foreground="{StaticResource NdText}" /><Run Text="Deck" Foreground="{StaticResource NdBrandHorizontal}" />
                        </TextBlock>
                        <TextBlock x:Name="VersionText" FontFamily="{StaticResource NdMono}" FontSize="11" Foreground="{StaticResource NdTextTertiary}"
                                   Text="stream deck · teclado numérico" />
                    </StackPanel>

                    <!-- Active profile chip -->
                    <Border Style="{StaticResource Pill}" Margin="24,0,0,0" Background="#1434D399" BorderBrush="#4034D399">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource NdGreen}" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#34D399" BlurRadius="8" ShadowDepth="0" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock FontFamily="{StaticResource NdMono}" FontSize="11" Foreground="#A7F3D0">
                                <Run Text="PERFIL ATIVO ·" /> <Run Text="{Binding ActiveProfileName, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="272" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="392" />
                </Grid.ColumnDefinitions>

                <!-- ===== Left: device, profiles, settings ===== -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- Device -->
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="// DISPOSITIVO" />
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Teclado do deck">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button HorizontalAlignment="Stretch" Command="{Binding IdentifyCommand}"
                                        ToolTip="Clique e depois aperte uma tecla no teclado que será o deck.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" Margin="0,0,8,0" Foreground="{StaticResource NdCyanBrush}" />
                                        <TextBlock Text="Identificar teclado" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="6,0,0,0" Content="&#xE72C;"
                                        Command="{Binding RefreshDevicesCommand}" ToolTip="Atualizar lista de teclados"
                                        AutomationProperties.Name="Atualizar lista de teclados" />
                            </Grid>
                            <!-- connection status -->
                            <Border Margin="0,10,0,0" CornerRadius="8" Padding="10,7" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#14F87171" />
                                        <Setter Property="BorderBrush" Value="#40F87171" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeckConnected}" Value="True">
                                                <Setter Property="Background" Value="#1434D399" />
                                                <Setter Property="BorderBrush" Value="#4034D399" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <Ellipse Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource NdRed}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeckConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource NdGreen}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#34D399" BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="{Binding DeviceStatus}" FontFamily="{StaticResource NdMono}" FontSize="11.5"
                                               Foreground="{StaticResource NdText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- Settings -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                            <Border Height="1" Background="{StaticResource NdStroke}" Margin="0,0,0,14" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="// CONFIGURAÇÕES" />
                            <CheckBox Content="Iniciar com o Windows" IsChecked="{Binding StartWithWindows}" />
                            <CheckBox Content="Avisar ao trocar de perfil" Margin="0,4,0,0" IsChecked="{Binding Config.ShowProfileNotifications}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button HorizontalAlignment="Stretch" Command="{Binding RestartElevatedCommand}"
                                        Visibility="{Binding IsElevated, Converter={x:Static vm:Converters.FalseToVisible}}"
                                        ToolTip="Necessário só para bloquear as teclas em programas que rodam como administrador.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7EF;" Margin="0,0,8,0" Foreground="{StaticResource NdVioletBrush}" />
                                        <TextBlock Text="Reiniciar como admin" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="6,0,0,0" Content="&#xE838;"
                                        Command="{Binding OpenConfigFolderCommand}" ToolTip="Abrir pasta da configuração"
                                        AutomationProperties.Name="Abrir pasta da configuração" />
                            </Grid>
                        </StackPanel>

                        <!-- Profiles -->
                        <DockPanel Margin="0,18,0,0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="6,0,0,0"
                                        Command="{Binding RemoveProfileCommand}" ToolTip="Excluir perfil" AutomationProperties.Name="Excluir perfil" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;"
                                        Command="{Binding AddProfileCommand}" ToolTip="Novo perfil" AutomationProperties.Name="Novo perfil" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="// PERFIS" VerticalAlignment="Center" Margin="0" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}"
                                       Text="Clique duplo para renomear. Arraste para mudar a ordem." />
                            <ListBox x:Name="ProfileList" ItemsSource="{Binding EditableProfiles}" SelectedItem="{Binding EditingProfile}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ItemContainerStyle="{StaticResource ProfileItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="ProfileList_MouseDoubleClick" KeyDown="ProfileList_KeyDown"
                                     ContextMenuOpening="ProfileList_ContextMenuOpening" AllowDrop="True"
                                     PreviewMouseLeftButtonDown="ProfileList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="ProfileList_PreviewMouseMove"
                                     DragOver="ProfileList_DragOver" DragLeave="ProfileList_DragLeave" Drop="ProfileList_Drop">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Renomear" InputGestureText="F2" Tag="rename" Click="ProfileMenu_Click" />
                                        <MenuItem Header="Ativar este perfil" Tag="activate" Click="ProfileMenu_Click" />
                                        <Separator />
                                        <MenuItem Header="Excluir" Tag="delete" Click="ProfileMenu_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <DockPanel x:Name="Caption">
                                                <TextBlock x:Name="ProfileGlyph" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8A9;"
                                                           FontSize="13" Margin="0,0,10,0" Foreground="{StaticResource NdTextTertiary}" />
                                                <Border x:Name="ActiveBadge" DockPanel.Dock="Right" Style="{StaticResource Pill}" Padding="6,1"
                                                        Background="#1434D399" BorderBrush="#4034D399" Visibility="Collapsed" Margin="6,0,0,0">
                                                    <TextBlock Text="ATIVO" FontFamily="{StaticResource NdMono}" FontSize="9.5" Foreground="#6EE7B7" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBox x:Name="RenameBox" Visibility="Collapsed" Margin="-8,-5" MinWidth="0"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Nome do perfil"
                                                     KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostKeyboardFocus"
                                                     IsVisibleChanged="RenameBox_IsVisibleChanged" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Id}" Value="global">
                                                <Setter TargetName="ProfileGlyph" Property="Text" Value="&#xE734;" />
                                                <Setter TargetName="ProfileGlyph" Property="Foreground" Value="{StaticResource NdVioletBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{x:Static vm:Converters.EqualValues}">
                                                        <Binding Path="Id" />
                                                        <Binding Path="DataContext.Config.ActiveProfileId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter TargetName="ActiveBadge" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="ProfileGlyph" Property="Foreground" Value="{StaticResource NdCyanBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{x:Static vm:Converters.SameObject}">
                                                        <Binding />
                                                        <Binding Path="DataContext.RenamingProfile" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Caption" Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </DockPanel>
                </Border>

                <!-- ===== Center: the deck ===== -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Command="{Binding ActivateProfileCommand}" VerticalAlignment="Center"
                                    Visibility="{Binding IsEditingActive, Converter={x:Static vm:Converters.FalseToVisible}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0" Foreground="{StaticResource NdGreen}" />
                                    <TextBlock Text="Ativar este perfil" />
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="// EDITANDO" Margin="0,0,0,2" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding EditingProfile.Name}" FontFamily="{StaticResource NdDisplay}" FontSize="20"
                                               FontWeight="SemiBold" Foreground="{StaticResource NdText}" />
                                    <Border Style="{StaticResource Pill}" Margin="10,2,0,0" Background="#1434D399" BorderBrush="#4034D399"
                                            Visibility="{Binding IsEditingActive, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="ATIVO" FontFamily="{StaticResource NdMono}" FontSize="10" Foreground="#6EE7B7" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,2,0,12"
                                   Text="Clique numa tecla para configurá-la · arraste uma tecla sobre outra para trocá-las · as teclas acendem quando você as aperta." />

                        <!-- Extra keys -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsLearning, Mode=OneWay}" Command="{Binding LearnCommand}"
                                              Padding="12,5"
                                              ToolTip="Para teclas extras do seu teclado (ex.: Backspace, Tab, Calculadora): clique e aperte a tecla.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7C8;" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="Aprender tecla do deck" />
                                    </StackPanel>
                                </ToggleButton>
                                <TextBlock Text="// OUTRAS TECLAS" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding ExtraCells}" Margin="-5,6,0,0" AllowDrop="True"
                                          PreviewMouseLeftButtonDown="Deck_PreviewMouseLeftButtonDown" PreviewMouseMove="Deck_PreviewMouseMove"
                                          DragOver="Deck_DragOver" DragLeave="Deck_DragLeave" Drop="Deck_Drop">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource DeckKey}" Width="116" Height="92"
                                                Command="{Binding DataContext.SelectCellCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- The numpad: keys on a device plate -->
                        <Viewbox Stretch="Uniform" MaxWidth="540" VerticalAlignment="Top">
                            <Border CornerRadius="26" Padding="14" Background="{StaticResource NdPlate}" BorderThickness="1">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#5522D3EE" Offset="0" />
                                        <GradientStop Color="#1A2B3850" Offset="0.5" />
                                        <GradientStop Color="#558B5CF6" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.55" />
                                </Border.Effect>
                                <ItemsControl ItemsSource="{Binding Cells}" Width="440" Height="530" AllowDrop="True"
                                              PreviewMouseLeftButtonDown="Deck_PreviewMouseLeftButtonDown" PreviewMouseMove="Deck_PreviewMouseMove"
                                              DragOver="Deck_DragOver" DragLeave="Deck_DragLeave" Drop="Deck_Drop">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                            </Grid>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Grid.Row" Value="{Binding Row}" />
                                            <Setter Property="Grid.Column" Value="{Binding Column}" />
                                            <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}" />
                                            <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource DeckKey}"
                                                    Command="{Binding DataContext.SelectCellCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Viewbox>
                    </DockPanel>
                </Border>

                <!-- ===== Right: key editor ===== -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <!-- nothing selected -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                    Visibility="{Binding SelectedCell, Converter={x:Static vm:Converters.NullToVisible}}">
                            <Border Width="64" Height="64" CornerRadius="16" BorderThickness="1.5" HorizontalAlignment="Center"
                                    BorderBrush="{StaticResource NdBrand}" Background="{StaticResource NdCyanSoft}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B0;" FontSize="26" HorizontalAlignment="Center"
                                           Foreground="{StaticResource NdCyanBrush}" />
                            </Border>
                            <TextBlock Text="Nenhuma tecla selecionada" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,6"
                                       HorizontalAlignment="Center" Foreground="{StaticResource NdText}" />
                            <TextBlock Text="Clique numa tecla do deck, ou aperte uma tecla no teclado físico, para escolher o que ela faz."
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource NdTextSecondary}" MaxWidth="260" />
                        </StackPanel>

                        <DockPanel Visibility="{Binding SelectedCell, Converter={x:Static vm:Converters.NotNullToVisible}}">
                            <!-- header: key chip + summary -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Border Width="52" Height="52" CornerRadius="12" Padding="1.5" Background="{StaticResource NdBrand}">
                                    <Border CornerRadius="11" Background="{StaticResource NdKeycap}">
                                        <TextBlock Text="{Binding SelectedCell.KeyLabel}" FontFamily="{StaticResource NdMono}" FontSize="15"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource NdText}" TextTrimming="CharacterEllipsis" Margin="4,0" />
                                    </Border>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="// TECLA SELECIONADA" Margin="0,0,0,3" />
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource NdText}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{x:Static vm:Converters.FirstNonEmpty}">
                                                <Binding Path="SelectedCell.Binding.Action.Summary" />
                                                <Binding Source="Sem ação" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>

                            <!-- footer -->
                            <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding ClearKeyCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,8,0" Foreground="{StaticResource NdRed}" />
                                        <TextBlock Text="Limpar tecla" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource BrandButton}" Margin="10,0,0,0" Command="{Binding TestActionCommand}"
                                        AutomationProperties.Name="Testar">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="Testar ação" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ação" />
                                    <ListBox ItemsSource="{Binding ActionTypes}" SelectedItem="{Binding SelectedActionType}"
                                             ItemContainerStyle="{StaticResource ActionTile}" Background="Transparent" BorderThickness="0"
                                             Padding="0" Margin="-3,0,-3,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Ação">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Visibility="{Binding SelectedCell.ShowsGlobal, Converter={StaticResource BoolToVisibility}}"
                                               Text="{Binding SelectedCell.GlobalBinding.Action.Summary, StringFormat=Sem ação neste perfil — vale a tecla global: {0}}" />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Nome na tecla (opcional)" />
                                    <TextBox Text="{Binding SelectedLabel, UpdateSourceTrigger=PropertyChanged}" />

                                    <Border Height="1" Background="{StaticResource NdStroke}" Margin="0,18,0,2"
                                            Visibility="{Binding SelectedCell.Binding.Action, Converter={x:Static vm:Converters.NotNullToVisible}}" />
                                    <ContentControl Content="{Binding SelectedCell.Binding.Action}" Margin="0,4,0,0" IsTabStop="False" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Status bar ===== -->
            <DockPanel Grid.Row="2" Margin="4,10,4,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding HookStatus, Converter={x:Static vm:Converters.NonEmptyToVisible}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{StaticResource NdRed}" Margin="0,0,6,0" />
                    <TextBlock Foreground="{StaticResource NdRed}" Text="{Binding HookStatus}" TextTrimming="CharacterEllipsis" MaxWidth="460"
                               FontFamily="{StaticResource NdMono}" FontSize="11.5" />
                </StackPanel>
                <TextBlock Text="&gt;_" FontFamily="{StaticResource NdMono}" FontSize="11.5" Foreground="{StaticResource NdCyanBrush}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource NdMono}" FontSize="11.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource NdTextSecondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource NdRed}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
