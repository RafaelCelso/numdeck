<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:NumDeck.App.ViewModels">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- ===================== Palette (Professional Neutral Dark) ===================== -->
    <Color x:Key="NdAccent">#2563EB</Color>
    <Color x:Key="NdAccentHover">#3B82F6</Color>
    <Color x:Key="NdAccentPressed">#1D4ED8</Color>
    <Color x:Key="NdAccentText">#60A5FA</Color>

    <SolidColorBrush x:Key="NdBg" Color="#141517" />
    <SolidColorBrush x:Key="NdHeaderBg" Color="#181A1E" />
    <SolidColorBrush x:Key="NdSurface" Color="#1C1E22" />
    <SolidColorBrush x:Key="NdSurfaceRaised" Color="#24272D" />
    <SolidColorBrush x:Key="NdSurfaceHover" Color="#2C3038" />
    <SolidColorBrush x:Key="NdStroke" Color="#2B2F36" />
    <SolidColorBrush x:Key="NdStrokeStrong" Color="#3D434E" />

    <SolidColorBrush x:Key="NdText" Color="#F0F2F5" />
    <SolidColorBrush x:Key="NdTextSecondary" Color="#9CA3AF" />
    <SolidColorBrush x:Key="NdTextTertiary" Color="#6B7280" />

    <SolidColorBrush x:Key="NdAccentBrush" Color="{StaticResource NdAccent}" />
    <SolidColorBrush x:Key="NdAccentHoverBrush" Color="{StaticResource NdAccentHover}" />
    <SolidColorBrush x:Key="NdAccentPressedBrush" Color="{StaticResource NdAccentPressed}" />
    <SolidColorBrush x:Key="NdAccentTextBrush" Color="{StaticResource NdAccentText}" />
    <SolidColorBrush x:Key="NdAccentSoft" Color="#1F3B82F6" />
    <SolidColorBrush x:Key="NdAccentEdge" Color="#663B82F6" />

    <SolidColorBrush x:Key="NdAmber" Color="#D9A441" />
    <SolidColorBrush x:Key="NdGreen" Color="#22C55E" />
    <SolidColorBrush x:Key="NdGreenSoft" Color="#1622C55E" />
    <SolidColorBrush x:Key="NdGreenBorder" Color="#3822C55E" />
    <SolidColorBrush x:Key="NdGreenText" Color="#86EFAC" />
    <SolidColorBrush x:Key="NdRed" Color="#E5534B" />
    <SolidColorBrush x:Key="NdRedSoft" Color="#16E5534B" />
    <SolidColorBrush x:Key="NdRedBorder" Color="#38E5534B" />

    <!-- Subtle matte keycap gradients -->
    <LinearGradientBrush x:Key="NdKeycap" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#262930" Offset="0" />
        <GradientStop Color="#202329" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NdKeycapConfigured" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#282C35" Offset="0" />
        <GradientStop Color="#22262E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NdKeycapHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2F343D" Offset="0" />
        <GradientStop Color="#272B33" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NdKeycapSelected" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1F2B3F" Offset="0" />
        <GradientStop Color="#1A2435" Offset="1" />
    </LinearGradientBrush>

    <!-- Matte aluminum/charcoal numpad chassis -->
    <LinearGradientBrush x:Key="NdPlate" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#121418" Offset="0" />
        <GradientStop Color="#16181D" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="NdIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="NdMono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="NdDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="NdUi">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- ===================== Text ===================== -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NdUi}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Foreground" Value="{StaticResource NdTextTertiary}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NdUi}" />
        <Setter Property="Margin" Value="0,14,0,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource NdTextSecondary}" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NdUi}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Foreground" Value="{StaticResource NdTextTertiary}" />
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NdIcons}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================== Surfaces ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NdSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource NdStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Compact status badge ("ATIVO", etc.) -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Subtle icon button -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource NdTextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource NdIcons}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6" Background="{StaticResource NdSurfaceRaised}"
                            BorderBrush="{StaticResource NdStroke}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NdSurfaceHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NdStrokeStrong}" />
                            <Setter Property="Foreground" Value="{StaticResource NdText}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NdBg}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NdStrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary call-to-action button ("Testar ação") -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6" Background="{StaticResource NdAccentBrush}"
                            BorderBrush="{StaticResource NdAccentHoverBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NdAccentHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NdAccentTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NdAccentPressedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NdAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Lists ===================== -->

    <!-- Profile rows -->
    <Style x:Key="ProfileItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource NdText}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                            Padding="10,8" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Bar" Width="2.5" CornerRadius="1.5" Margin="-10,-2,0,-2" HorizontalAlignment="Left"
                                    Background="{StaticResource NdAccentHoverBrush}" Visibility="Collapsed" />
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NdSurfaceRaised}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NdAccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NdAccentEdge}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Action type tiles (icon + short name) -->
    <Style x:Key="ActionTile" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource NdTextSecondary}" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="ToolTip" Value="{Binding Name}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="6" Background="{StaticResource NdSurfaceRaised}" BorderThickness="1"
                            BorderBrush="{StaticResource NdStroke}" Height="60">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="Glyph" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="17"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ShortName}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NdSurfaceHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NdStrokeStrong}" />
                            <Setter Property="Foreground" Value="{StaticResource NdText}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NdAccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NdAccentHoverBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource NdAccentTextBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource NdText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Deck key ===================== -->
    <!-- A key on the on-screen deck. DataContext = KeyCellViewModel. -->
    <Style x:Key="DeckKey" TargetType="Button">
        <Setter Property="Margin" Value="4.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="AutomationProperties.Name" Value="{Binding KeyLabel, StringFormat=Tecla {0}}" />
        <Setter Property="Foreground" Value="{StaticResource NdText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Cap">
                        <!-- Subtle physical keycap shadow -->
                        <Border CornerRadius="8" Background="#000000" Opacity="0.32" Margin="0,2,0,-2">
                            <Border.Effect>
                                <BlurEffect Radius="4" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Edge" CornerRadius="8" Padding="1" Background="{StaticResource NdStroke}">
                            <Border x:Name="Root" CornerRadius="7" Background="{StaticResource NdKeycap}" Padding="8,7">
                                <Grid>
                                    <!-- Subtle top bevel highlight -->
                                    <Border CornerRadius="7,7,0,0" Height="1" VerticalAlignment="Top" Margin="2,-6,2,0" Background="#10FFFFFF" />
                                    <TextBlock x:Name="KeyName" Text="{Binding KeyLabel}" FontFamily="{StaticResource NdMono}" FontSize="10.5"
                                               Foreground="{StaticResource NdTextTertiary}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <Ellipse x:Name="Dot" Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0"
                                             Fill="{StaticResource NdAccentHoverBrush}" Visibility="Collapsed" />

                                    <StackPanel x:Name="Body" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0">
                                        <Grid HorizontalAlignment="Center" Width="26" Height="26">
                                            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="19" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource NdAccentTextBrush}"
                                                       Text="{Binding Binding.Action, Converter={x:Static vm:Converters.ActionGlyph}}" />
                                            <Image x:Name="AppIcon" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"
                                                   Source="{Binding Binding.Action.Apps[0].Path, Converter={x:Static vm:Converters.ShellIcon}}" />
                                        </Grid>
                                        <TextBlock x:Name="Title" FontWeight="SemiBold" FontSize="11.5" Margin="0,6,0,0"
                                                   TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{x:Static vm:Converters.FirstNonEmpty}">
                                                    <Binding Path="Binding.Label" />
                                                    <Binding Path="Binding.Action.Summary" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock x:Name="Sub" Text="{Binding Binding.Action.Summary}" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="{StaticResource NdTextSecondary}" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Binding.Label, Converter={x:Static vm:Converters.NonEmptyToVisible}}" />
                                    </StackPanel>

                                    <!-- Inherited from "Teclas globais" -->
                                    <StackPanel x:Name="Inherited" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.72"
                                                Visibility="{Binding ShowsGlobal, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center" Foreground="{StaticResource NdAmber}"
                                                   Text="{Binding GlobalBinding.Action, Converter={x:Static vm:Converters.ActionGlyph}}" />
                                        <TextBlock Text="{Binding GlobalBinding.Action.Summary, StringFormat=★ {0}}" FontSize="10.5" Margin="0,5,0,0"
                                                   Foreground="{StaticResource NdTextSecondary}" TextAlignment="Center" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="28" />
                                    </StackPanel>

                                    <!-- Empty key: "+" on hover -->
                                    <TextBlock x:Name="Plus" Style="{StaticResource Icon}" Text="&#xE710;" FontSize="15" Margin="0,8,0,0"
                                               HorizontalAlignment="Center" Foreground="{StaticResource NdTextTertiary}" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Configured key: clean border & status dot -->
                        <DataTrigger Binding="{Binding Binding.Action, Converter={x:Static vm:Converters.IsNotNull}}" Value="True">
                            <Setter TargetName="Edge" Property="Background" Value="{StaticResource NdStrokeStrong}" />
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource NdKeycapConfigured}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Binding.Action}" Value="{x:Null}">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Source, ElementName=AppIcon, Converter={x:Static vm:Converters.IsNotNull}}" Value="True">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource NdKeycapHover}" />
                            <Setter TargetName="Edge" Property="Background" Value="#4B5362" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Binding.Action}" Value="{x:Null}" />
                                <Condition Binding="{Binding ShowsGlobal}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Plus" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Edge" Property="Background" Value="{StaticResource NdAccentHoverBrush}" />
                            <Setter TargetName="Edge" Property="Padding" Value="1.5" />
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource NdKeycapSelected}" />
                            <Setter TargetName="KeyName" Property="Foreground" Value="{StaticResource NdAccentTextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                            <Setter TargetName="Cap" Property="Opacity" Value="0.35" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                            <Setter TargetName="Edge" Property="Background" Value="{StaticResource NdAccentHoverBrush}" />
                            <Setter TargetName="Edge" Property="Padding" Value="2" />
                            <Setter TargetName="Root" Property="Background" Value="#1E3250" />
                        </DataTrigger>
                        <!-- Physical key pressed on the deck -->
                        <DataTrigger Binding="{Binding IsPressed}" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource NdAccentBrush}" />
                            <Setter TargetName="Edge" Property="Background" Value="{StaticResource NdAccentTextBrush}" />
                            <Setter TargetName="Dot" Property="Fill" Value="#FFFFFF" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="#FFFFFF" />
                            <Setter TargetName="KeyName" Property="Foreground" Value="#DBEAFE" />
                            <Setter TargetName="Sub" Property="Foreground" Value="#DBEAFE" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
